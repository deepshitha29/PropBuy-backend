# Database Configuration (MySQL 8.x)
# Required for production (e.g. TiDB Cloud / Aiven / Local MySQL):
DB_URL=jdbc:mysql://localhost:3306/propbuy?serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=change-me

# Security: minimum 32 random characters
APP_JWT_SECRET=replace-with-at-least-32-random-characters

# CORS origins: comma-separated list of allowed web origins
# For Vercel frontend deployments, include https://*.vercel.app
CORS_ORIGINS=http://localhost:8080,http://localhost:5500,https://*.vercel.app

# Upload directory for property photos
UPLOAD_DIR=uploads

# Demo profile toggle: set SPRING_PROFILES_ACTIVE=demo to run in-memory without MySQL
SPRING_PROFILES_ACTIVE=demo
DEMO_MODE=true
